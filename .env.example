# Postgres. Use the POOLED connection string.
# Without it the app falls back to a JSON file store — development only.
DATABASE_URL=

# Secret the daily dig seed is derived from. Set it once and never rotate it
# mid-window: rotating changes every unrevealed outcome.
ARC_SEED_SECRET=

# Quest window, ISO 8601. Digging is refused outside it.
ARC_WINDOW_OPEN=2026-10-01T00:00:00Z
ARC_WINDOW_CLOSE=2026-10-15T00:00:00Z

# Development only, ignored when NODE_ENV=production.
ARC_SKIP_POST_CHECK=

# JSON fallback store location.
ARC_DB_PATH=.data/shaft.json
